# ==============================================================================
# Production Environment Configuration Template (.env.example)
# Data Enrichment AI Intelligence Platform
# ==============================================================================
# Instructions for GCP VM:
# 1. Copy this file to .env in infrastructure/docker/:
#      cp infrastructure/docker/.env.example infrastructure/docker/.env
# 2. Fill in all REQUIRED secrets, passwords, and your VM's public IP.
# 3. DO NOT commit the .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & VM NETWORKING
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=data-enrich-intell-project

# Public IP address of the GCP Compute Engine VM (e.g. 34.93.207.65)
VM_IP=your_vm_public_ip_here

# ------------------------------------------------------------------------------
# 2. DATABASE LAYER (MySQL :3306 - Internal Only)
# ------------------------------------------------------------------------------
# REQUIRED: Strong password for MySQL root user
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password_here

# Logical database name (default: enrichment_db)
MYSQL_DATABASE=enrichment_db

# Application database user
MYSQL_USER=user

# REQUIRED: Strong password for application database user
MYSQL_PASSWORD=your_strong_mysql_user_password_here

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Auth Service :9739 & API Gateway :9738)
# ------------------------------------------------------------------------------
# REQUIRED: Cryptographically secure 256-bit secret key for JWT signing (HS256)
# Generate via: openssl rand -base64 32
JWT_SECRET=your_base64_256bit_jwt_secret_here

# JWT token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# OPTIONAL: Gateway API key for X-API-Key header authentication
# Leave blank ("") to disable API key requirement (open access mode)
GATEWAY_API_KEY=

# CORS Allowed Origins (Comma-separated list of origins permitted to call the Gateway)
GATEWAY_CORS_ALLOWED_ORIGINS=http://${VM_IP}:3000,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. FRONTEND BROWSER-FACING ENDPOINTS (:3000)
# ------------------------------------------------------------------------------
# The public API Gateway URL accessible from user browsers outside the VM
NEXT_PUBLIC_GATEWAY_URL=http://${VM_IP}:9738
NEXT_PUBLIC_RESEARCH_SERVICE_URL=http://${VM_IP}:9738
NEXT_PUBLIC_AI_INTELLIGENT_SERVICE_URL=http://${VM_IP}:9738
NEXT_PUBLIC_DATASET_SERVICE_URL=http://${VM_IP}:9738
NEXT_PUBLIC_AUTH_SERVICE_URL=http://${VM_IP}:9738

# ------------------------------------------------------------------------------
# 5. AI INTELLIGENT SERVICE (:9742)
# ------------------------------------------------------------------------------
# Google Gemini API key (Required if AI_MOCK_MODE=false)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Gemini model identifier (e.g. gemini-2.0-flash or gemini-1.5-flash)
AI_MODEL=gemini-2.0-flash

# Set to true to bypass Gemini API calls and return deterministic mock extractions
AI_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 6. RESEARCH SERVICE (:9741)
# ------------------------------------------------------------------------------
# Search provider: 'tavily' (live web search) or 'mock' (offline test fixtures)
SEARCH_PROVIDER_NAME=tavily

# Tavily Search API key (Required if SEARCH_PROVIDER_NAME=tavily)
# Obtain from: https://tavily.com
SEARCH_PROVIDER_API_KEY=your_tavily_search_api_key_here

# Search provider base endpoint
SEARCH_PROVIDER_BASE_URL=https://api.tavily.com

# Maximum search results to fetch per discovery query
SEARCH_DISCOVERY_MAX_RESULTS=5

# Discovery search query timeout in milliseconds
SEARCH_DISCOVERY_TIMEOUT_MS=4000

# Web page scraping connect & read timeouts (milliseconds)
WEB_FETCH_CONNECT_TIMEOUT_MS=3000
WEB_FETCH_READ_TIMEOUT_MS=5000

# Maximum response size allowed for web content fetching (MB)
WEB_FETCH_MAX_RESPONSE_SIZE_MB=5

# Maximum evidence sources collected per entity
RESEARCH_MAX_SOURCES=5

# Maximum text content length parsed per document (characters)
RESEARCH_MAX_CONTENT_LENGTH=50000

# ------------------------------------------------------------------------------
# 7. DATASET SERVICE (:9743)
# ------------------------------------------------------------------------------
# Maximum concurrent entity enrichment worker threads
ENRICHMENT_CONCURRENCY=3

# In-memory enrichment task queue capacity
ENRICHMENT_QUEUE_CAPACITY=500

# Per-entity enrichment timeout in seconds
ENRICHMENT_ENTITY_TIMEOUT=60

# Full batch enrichment job timeout in minutes
ENRICHMENT_JOB_TIMEOUT=30

# Enable/disable AI enrichment during dataset batch execution
ENRICHMENT_AI_ENABLED=true
