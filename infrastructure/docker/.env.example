# ==============================================================================
# Docker Development Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env before starting containers:
#   Copy-Item infrastructure/docker/.env.example infrastructure/docker/.env
# ==============================================================================

# 1. Docker Compose Project Name
COMPOSE_PROJECT_NAME=data-enrich-intell-project

# 2. MySQL Database Configuration
# NOTE: MYSQL_USER must be a regular non-root user (e.g. enrichment_user).
# Do not set MYSQL_USER=root as official MySQL images reject this.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=enrichment_db
MYSQL_USER=enrichment_user
MYSQL_PASSWORD=enrichment_password

# 3. AI Intelligence Service (Spring AI / Google GenAI)
GEMINI_API_KEY=your-gemini-api-key-here

# 4. Frontend Client Backend Endpoints (Host/Browser-accessible URLs)
NEXT_PUBLIC_RESEARCH_SERVICE_URL=http://localhost:9741
NEXT_PUBLIC_AI_INTELLIGENT_SERVICE_URL=http://localhost:9742
NEXT_PUBLIC_DATASET_SERVICE_URL=http://localhost:9743

# 5. Search Discovery Provider Configuration (research-service Phase 1)
SEARCH_PROVIDER_NAME=mock
SEARCH_PROVIDER_API_KEY=your-search-provider-api-key-here
SEARCH_PROVIDER_BASE_URL=https://api.tavily.com
SEARCH_DISCOVERY_MAX_RESULTS=5
SEARCH_DISCOVERY_TIMEOUT_MS=4000

