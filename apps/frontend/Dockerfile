FROM node:22-alpine
WORKDIR /app

# 1. Copy dependency manifests
COPY package*.json ./

# 2. Install dependencies
RUN npm ci --prefer-offline || npm install

# 3. Copy application source tree
COPY . .

# 4. Set build arguments and environment variables for Next.js production build
ARG NEXT_PUBLIC_GATEWAY_URL=http://localhost:9738
ARG NEXT_PUBLIC_RESEARCH_SERVICE_URL
ARG NEXT_PUBLIC_AI_SERVICE_URL
ARG NEXT_PUBLIC_DATASET_SERVICE_URL
ARG NEXT_PUBLIC_AUTH_SERVICE_URL
ARG NEXT_PUBLIC_GATEWAY_API_KEY

ENV NEXT_PUBLIC_GATEWAY_URL=$NEXT_PUBLIC_GATEWAY_URL
ENV NEXT_PUBLIC_RESEARCH_SERVICE_URL=$NEXT_PUBLIC_RESEARCH_SERVICE_URL
ENV NEXT_PUBLIC_AI_SERVICE_URL=$NEXT_PUBLIC_AI_SERVICE_URL
ENV NEXT_PUBLIC_DATASET_SERVICE_URL=$NEXT_PUBLIC_DATASET_SERVICE_URL
ENV NEXT_PUBLIC_AUTH_SERVICE_URL=$NEXT_PUBLIC_AUTH_SERVICE_URL
ENV NEXT_PUBLIC_GATEWAY_API_KEY=$NEXT_PUBLIC_GATEWAY_API_KEY
ENV NODE_ENV=production

# 5. Build application for production
RUN npm run build

ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

EXPOSE 3000

# 6. Start Next.js production server
CMD ["npm", "start"]
