# ==============================================================================
# Data Enrichment & Research Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your environment-specific credentials.
# Note: apps/.env is ignored by Git to protect secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
PORT=3000

# Backend service URLs consumed by the frontend client
NEXT_PUBLIC_RESEARCH_SERVICE_URL=http://localhost:9741
NEXT_PUBLIC_AI_INTELLIGENT_SERVICE_URL=http://localhost:9742
NEXT_PUBLIC_DATASET_SERVICE_URL=http://localhost:9743

# ------------------------------------------------------------------------------
# 2. Backend Services Configuration
# ------------------------------------------------------------------------------

# Research Service (Port 9741)
RESEARCH_SERVICE_PORT=9741
RESEARCH_SERVICE_URL=http://localhost:9741

# AI Intelligent Service (Port 9742)
AI_INTELLIGENT_SERVICE_PORT=9742
AI_INTELLIGENT_SERVICE_URL=http://localhost:9742

# Dataset Service (Port 9743)
DATASET_SERVICE_PORT=9743
DATASET_SERVICE_URL=http://localhost:9743

# ------------------------------------------------------------------------------
# 3. AI / LLM Provider Configuration (ai-intelligent-service)
# ------------------------------------------------------------------------------
# API key for Google GenAI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. Database Configuration (dataset-service)
# ------------------------------------------------------------------------------
# MySQL connection parameters
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/enrichment_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 5. Actuator & Monitoring
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
