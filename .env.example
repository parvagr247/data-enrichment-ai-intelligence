

# 1. Platform Infrastructure & API Gateway
CONFIG_SERVER_PORT=9736
CONFIG_SERVER_URL=http://localhost:9736

DISCOVERY_SERVER_PORT=9737
EUREKA_SERVER_URL=http://localhost:9737/eureka/

GATEWAY_PORT=9738
GATEWAY_URL=http://localhost:9738


GATEWAY_API_KEY=
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Database (MySQL :3306)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=enrichment_db
MYSQL_USER=enrichment_user
MYSQL_PASSWORD=enrichment_password
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 3. Research Service (:9741)
# ------------------------------------------------------------------------------
RESEARCH_SERVICE_PORT=9741
AI_INTELLIGENT_SERVICE_URL=http://localhost:9742
DATASET_SERVICE_URL=http://localhost:9743

# Search Provider Configuration ('mock' or 'tavily')
SEARCH_PROVIDER_NAME=mock
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_BASE_URL=https://api.tavily.com
SEARCH_DISCOVERY_MAX_RESULTS=5
SEARCH_DISCOVERY_TIMEOUT_MS=4000

# Web Scraper & Network Guardrails
WEB_FETCH_CONNECT_TIMEOUT_MS=3000
WEB_FETCH_READ_TIMEOUT_MS=5000
WEB_FETCH_MAX_RESPONSE_SIZE_MB=5
RESEARCH_MAX_SOURCES=5
RESEARCH_MAX_CONTENT_LENGTH=50000

# ------------------------------------------------------------------------------
# 4. AI Intelligent Service (:9742)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=9742
AI_MOCK_MODE=false
# Set GEMINI_API_KEY to your Google Gemini API key.
# If empty or invalid, the service gracefully falls back to deterministic extraction.
GEMINI_API_KEY=mock-key
AI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 5. Dataset Service (:9743)
# ------------------------------------------------------------------------------
DATASET_SERVICE_PORT=9743
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/enrichment_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=enrichment_user
SPRING_DATASOURCE_PASSWORD=enrichment_password

# ------------------------------------------------------------------------------
# 6. Auth Service (:9739) & Security
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=9739
AUTH_SERVICE_URL=http://localhost:9739
JWT_SECRET=enrichment-platform-super-secret-jwt-signing-key-256-bits-minimum-required
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 7. Frontend (Next.js :3000)
# ------------------------------------------------------------------------------
PORT=3000
# By default, frontend routes all microservice calls through the API Gateway (:9738)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:9738
NEXT_PUBLIC_GATEWAY_API_KEY=
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:9738
NEXT_PUBLIC_RESEARCH_SERVICE_URL=http://localhost:9738
NEXT_PUBLIC_AI_INTELLIGENT_SERVICE_URL=http://localhost:9738
NEXT_PUBLIC_DATASET_SERVICE_URL=http://localhost:9738
