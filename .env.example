# ==============================================================================
# Data Enrichment AI Intelligence Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# Fill in real API keys if using live Tavily / Google Gemini integrations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (MySQL)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=enrichment_db
MYSQL_USER=enrichment_user
MYSQL_PASSWORD=enrichment_password
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 2. Research Service (:9741)
# ------------------------------------------------------------------------------
RESEARCH_SERVICE_PORT=9741
AI_INTELLIGENT_SERVICE_URL=http://localhost:9742
DATASET_SERVICE_URL=http://localhost:9743

# Search Provider Configuration ('mock' or 'tavily')
SEARCH_PROVIDER_NAME=mock
SEARCH_PROVIDER_API_KEY=
SEARCH_PROVIDER_BASE_URL=https://api.tavily.com
SEARCH_DISCOVERY_MAX_RESULTS=5
SEARCH_DISCOVERY_TIMEOUT_MS=4000

# Web Scraper & Network Guardrails
WEB_FETCH_CONNECT_TIMEOUT_MS=3000
WEB_FETCH_READ_TIMEOUT_MS=5000
WEB_FETCH_MAX_RESPONSE_SIZE_MB=5
RESEARCH_MAX_SOURCES=5
RESEARCH_MAX_CONTENT_LENGTH=50000

# ------------------------------------------------------------------------------
# 3. AI Intelligent Service (:9742)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=9742
# Set GEMINI_API_KEY to your Google Gemini API key.
# If empty or invalid, the service gracefully falls back to deterministic extraction.
GEMINI_API_KEY=mock-key

# ------------------------------------------------------------------------------
# 4. Dataset Service (:9743)
# ------------------------------------------------------------------------------
DATASET_SERVICE_PORT=9743
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/enrichment_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=enrichment_user
SPRING_DATASOURCE_PASSWORD=enrichment_password

# ------------------------------------------------------------------------------
# 5. Frontend (Next.js :3000)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_RESEARCH_SERVICE_URL=http://localhost:9741
NEXT_PUBLIC_AI_INTELLIGENT_SERVICE_URL=http://localhost:9742
NEXT_PUBLIC_DATASET_SERVICE_URL=http://localhost:9743
