              "path": ["api", "v1", "ai", "clean"]
            },
            "description": "Cleans sparse, noisy input rows before starting batch enrichment."
          }
        },
        {
          "name": "Direct Single-Record Enrichment Preview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
