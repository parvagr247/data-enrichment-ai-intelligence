      "name": "01 Health",
      "description": "Probes Spring Boot Actuator health endpoints across all 3 microservices to confirm availability and readiness.",
      "item": [
        {
          "name": "Dataset Service Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Application status is UP\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{datasetBaseUrl}}/actuator/health",
