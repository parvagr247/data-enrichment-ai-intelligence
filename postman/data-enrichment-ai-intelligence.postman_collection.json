    {
      "name": "Research Service",
      "item": [
        {
          "name": "Synchronous Research",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://github.com/spring-projects/spring-boot\",\n  \"entityType\": \"REPOSITORY\",\n  \"name\": \"Spring Boot\"\n}"
            },
            "url": {
              "raw": "{{baseResearchUrl}}/api/v1/research",
              "host": ["{{baseResearchUrl}}"],
              "path": ["api", "v1", "research"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains completed status and entityId\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.be.oneOf([\"COMPLETED\", \"PARTIAL\"]);",
                  "    pm.expect(json.entityId).to.be.a(\"string\");",
                  "    pm.expect(json.result).to.be.an(\"object\");",
                  "    pm.expect(json.sources).to.be.an(\"array\");",
                  "    if (json.entityId) {",
                  "        pm.collectionVariables.set(\"entityId\", json.entityId);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
