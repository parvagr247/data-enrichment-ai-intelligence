    {
      "name": "02 Dataset",
      "description": "Dataset preparation, column confirmation, and seed cleansing operations.",
      "item": [
        {
          "name": "Cleanse Dataset Seed Input",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Input cleaned successfully\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.cleanedName).to.be.a('string');",
                  "    pm.expect(json.detectedEntityType).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rawName\": \"  Dr. Linus Torvalds, PhD 🚀 \",\n  \"rawUrl\": \"https://github.com/torvalds?tab=repositories\",\n  \"rawOrganization\": \"Linux Foundation, Inc.\",\n  \"rawRole\": \"Principal Fellow & Creator\"\n}"
            },
            "url": {
              "raw": "{{aiBaseUrl}}/api/v1/ai/clean",
              "host": ["{{aiBaseUrl}}"],
              "path": ["api", "v1", "ai", "clean"]
            },
            "description": "Cleans sparse, noisy input rows before starting batch enrichment."
          }
        },
        {
          "name": "Direct Single-Record Enrichment Preview",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Row enrichment result returned\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('rowIndex');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"row\": {\n    \"Name\": \"Spring Boot\",\n    \"URL\": \"https://github.com/spring-projects/spring-boot\",\n    \"Role\": \"Framework\"\n  },\n  \"columnMapping\": {\n    \"nameColumn\": \"Name\",\n    \"urlColumn\": \"URL\",\n    \"roleColumn\": \"Role\"\n  },\n  \"entityType\": \"REPOSITORY\",\n  \"userRequirement\": \"Extract primary programming language, stars count, and license\"\n}"
            },
            "url": {
              "raw": "{{datasetBaseUrl}}/api/v1/enrichment/single",
              "host": ["{{datasetBaseUrl}}"],
              "path": ["api", "v1", "enrichment", "single"]
            },
            "description": "Enriches a single mapped row synchronously."
          }
        }
      ]
    },
    {
      "name": "03 Enrichment",
      "description": "Batch dataset enrichment jobs and row-level status tracking.",
      "item": [
        {
          "name": "Start Batch Enrichment Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.jobId) {",
                  "    pm.collectionVariables.set(\"jobId\", json.jobId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datasetName\": \"test-repositories.csv\",\n  \"userRequirement\": \"Find primary programming language, stars count, and license\",\n  \"defaultEntityType\": \"REPOSITORY\",\n  \"columnMapping\": {\n    \"nameColumn\": \"RepoName\",\n    \"urlColumn\": \"RepoUrl\"\n  },\n  \"rows\": [\n    {\n      \"RepoName\": \"Spring Boot\",\n      \"RepoUrl\": \"https://github.com/spring-projects/spring-boot\"\n    },\n    {\n      \"RepoName\": \"Next.js\",\n      \"RepoUrl\": \"https://github.com/vercel/next.js\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{datasetBaseUrl}}/api/v1/enrichment/jobs",
              "host": ["{{datasetBaseUrl}}"],
              "path": ["api", "v1", "enrichment", "jobs"]
            },
            "description": "Dispatches an asynchronous batch enrichment job with row-level error isolation."
          }
        },
        {
          "name": "Get Enrichment Job Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Job response has progress counters\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('jobId');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('totalRows');",
                  "    pm.expect(json).to.have.property('completedRows');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{datasetBaseUrl}}/api/v1/enrichment/jobs/{{jobId}}",
              "host": ["{{datasetBaseUrl}}"],
              "path": ["api", "v1", "enrichment", "jobs", "{{jobId}}"]
            },
            "description": "Polls the status and row results of a batch enrichment job."
          }
        }
      ]
    },
    {
