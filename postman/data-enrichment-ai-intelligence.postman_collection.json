    {
      "name": "05 AI",
      "description": "AI intelligence services powered by Spring AI and Google Gemini with heuristic fallbacks.",
      "item": [
        {
          "name": "AI Requirement Interpretation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Interprets target fields\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.targetFields).to.be.an('array');",
                  "    pm.expect(json.searchKeywords).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
