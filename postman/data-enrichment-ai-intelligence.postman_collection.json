            "body": {
              "mode": "raw",
              "raw": "{\n  \"row\": {\n    \"Name\": \"Spring Boot\",\n    \"URL\": \"https://github.com/spring-projects/spring-boot\",\n    \"Role\": \"Framework\"\n  },\n  \"columnMapping\": {\n    \"nameColumn\": \"Name\",\n    \"urlColumn\": \"URL\",\n    \"roleColumn\": \"Role\"\n  },\n  \"entityType\": \"REPOSITORY\",\n  \"userRequirement\": \"Extract primary programming language, stars count, and license\"\n}"
