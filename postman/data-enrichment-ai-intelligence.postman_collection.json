    {
      "name": "02 Dataset",
      "description": "Dataset preparation, column confirmation, and seed cleansing operations.",
      "item": [
        {
          "name": "Cleanse Dataset Seed Input",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Input cleaned successfully\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.cleanedName).to.be.a('string');",
                  "    pm.expect(json.detectedEntityType).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rawName\": \"  Dr. Linus Torvalds, PhD 🚀 \",\n  \"rawUrl\": \"https://github.com/torvalds?tab=repositories\",\n  \"rawOrganization\": \"Linux Foundation, Inc.\",\n  \"rawRole\": \"Principal Fellow & Creator\"\n}"
