    {
      "name": "06 Results",
      "description": "Saved entities catalog and persistent audit trail in MySQL.",
      "item": [
        {
          "name": "Get Saved Entities Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (Array.isArray(json) && json.length > 0) {",
                  "    pm.collectionVariables.set(\"entityId\", json[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{datasetBaseUrl}}/api/v1/entities?page=0&size=20",
              "host": ["{{datasetBaseUrl}}"],
              "path": ["api", "v1", "entities"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "Fetches paginated list of saved entity snapshots from MySQL."
          }
        },
        {
          "name": "Get Entity Detail By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 404 Not Found\", function () {",
