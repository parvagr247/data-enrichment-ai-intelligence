    {
      "name": "03 Enrichment",
      "description": "Batch dataset enrichment jobs and row-level status tracking.",
      "item": [
        {
          "name": "Start Batch Enrichment Job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 202 Accepted\", function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.jobId) {",
                  "    pm.collectionVariables.set(\"jobId\", json.jobId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datasetName\": \"test-repositories.csv\",\n  \"userRequirement\": \"Find primary programming language, stars count, and license\",\n  \"defaultEntityType\": \"REPOSITORY\",\n  \"columnMapping\": {\n    \"nameColumn\": \"RepoName\",\n    \"urlColumn\": \"RepoUrl\"\n  },\n  \"rows\": [\n    {\n      \"RepoName\": \"Spring Boot\",\n      \"RepoUrl\": \"https://github.com/spring-projects/spring-boot\"\n    },\n    {\n      \"RepoName\": \"Next.js\",\n      \"RepoUrl\": \"https://github.com/vercel/next.js\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{datasetBaseUrl}}/api/v1/enrichment/jobs",
              "host": ["{{datasetBaseUrl}}"],
              "path": ["api", "v1", "enrichment", "jobs"]
            },
            "description": "Dispatches an asynchronous batch enrichment job with row-level error isolation."
          }
        },
        {
          "name": "Get Enrichment Job Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Job response has progress counters\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('jobId');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('totalRows');",
                  "    pm.expect(json).to.have.property('completedRows');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{datasetBaseUrl}}/api/v1/enrichment/jobs/{{jobId}}",
              "host": ["{{datasetBaseUrl}}"],
              "path": ["api", "v1", "enrichment", "jobs", "{{jobId}}"]
            },
            "description": "Polls the status and row results of a batch enrichment job."
          }
        }
      ]
    },
